# MiniMax API
MINIMAX_API_KEY=your_minimax_api_key_here

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Clerk Authentication
# Get these from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Convex
# Get this from https://dashboard.convex.dev after running `npx convex dev`
VITE_CONVEX_URL=https://your-project.convex.cloud

# Clerk JWT Issuer Domain (for Convex backend auth)
# This is found in Clerk Dashboard > JWT Templates > Convex template
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.clerk.accounts.dev
